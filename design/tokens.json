{
  "name": "Twiq",
  "version": 1,
  "themes": [
    "light",
    "dark"
  ],
  "meta": {
    "direction": "铝灰中性色 + 信号橙强调色（与应用图标「微调旋钮」一致）；桌面工具，中性色承担 90% 面积，强调色只用于主行动、选中与焦点",
    "note": "bg / surface / line / ink / ink-muted / focus 六个基础色是原始值；其余 token 由这六个色派生，并按 pairs 逐对验证对比度",
    "overlay": "预览叠加层在 closed shadow DOM 中单独定义 token；页面本身的样式与颜色不受应用主题影响"
  },
  "color": {
    "bg": {
      "light": "#F4F3F1",
      "dark": "#131314",
      "usage": "应用外壳背景；工具栏、标签栏外的空白。"
    },
    "surface": {
      "light": "#FFFFFF",
      "dark": "#1C1C1E",
      "usage": "工具栏、标签栏、属性面板、状态栏等凸起表面。"
    },
    "surface-raised": {
      "light": "#FFFFFF",
      "dark": "#262628",
      "usage": "浮层（toast、菜单）表面；暗色下比 surface 更亮一级。"
    },
    "surface-sunken": {
      "light": "#EDEBE7",
      "dark": "#0D0D0E",
      "usage": "输入框、代码块、kbd 等凹陷区域。"
    },
    "preview-bg": {
      "light": "#E8E6E2",
      "dark": "#0A0A0B",
      "usage": "预览区画布外围；被预览页面的颜色由文档自身决定。"
    },
    "line": {
      "light": "#E2DFDA",
      "dark": "#2E2E31",
      "usage": "分隔线与装饰性边框，不单独承载含义。"
    },
    "line-strong": {
      "light": "#8A8780",
      "dark": "#7A7A80",
      "usage": "输入框、选择器等可交互控件的边界；对 bg / surface ≥ 3:1。"
    },
    "ink": {
      "light": "#1C1B19",
      "dark": "#F2F1EF",
      "usage": "正文、标题与主要图标，落在 bg / surface / hover / active 上。"
    },
    "ink-muted": {
      "light": "#5E5B55",
      "dark": "#ADABA6",
      "usage": "说明文字、次要标签，落在 bg / surface 上。"
    },
    "ink-faint": {
      "light": "#6B6862",
      "dark": "#93918C",
      "usage": "路径分隔符、列表编号等第三级文字；对 surface ≥ 4.5:1。"
    },
    "accent": {
      "light": "#C2410C",
      "dark": "#FF7A3D",
      "usage": "信号橙强调色（与图标同色族，浅色压暗以保证 4.5:1）：主行动、选中态、焦点环；也可作强调文字落在 bg / surface / accent-soft 上。"
    },
    "on-accent": {
      "light": "#FFFFFF",
      "dark": "#1A0E06",
      "usage": "强调色填充上的文字与图标。"
    },
    "accent-hover": {
      "light": "#A8380A",
      "dark": "#FF9461",
      "usage": "主按钮悬停；明度朝远离文字的方向移动。"
    },
    "accent-pressed": {
      "light": "#8F2F08",
      "dark": "#F06424",
      "usage": "主按钮按下。"
    },
    "accent-soft": {
      "light": "#FDF0E8",
      "dark": "#3A2216",
      "usage": "选中行、分段控件、强调底色。"
    },
    "accent-tint": {
      "light": "#C2410C1F",
      "dark": "#FF7A3D1F",
      "usage": "拖拽遮罩与选区光晕的淡强调底（12% 透明）。"
    },
    "focus": {
      "light": "#C2410C",
      "dark": "#FF7A3D",
      "usage": "键盘焦点环；对 bg / surface ≥ 3:1。"
    },
    "success": {
      "light": "#0E7A5C",
      "dark": "#34D3A5",
      "usage": "改字框、完成状态；可作文字落在 surface 上，也可作填充配 on-success。"
    },
    "on-success": {
      "light": "#FFFFFF",
      "dark": "#131314",
      "usage": "success 填充上的文字（改字标签）。"
    },
    "success-soft": {
      "light": "#E3F4EE",
      "dark": "#14332A",
      "usage": "已记录修改的淡绿闪示。"
    },
    "danger": {
      "light": "#B4233F",
      "dark": "#FF8FA3",
      "usage": "错误文字、危险操作、错误框；也可作填充配 on-danger。"
    },
    "on-danger": {
      "light": "#FFFFFF",
      "dark": "#2B0A12",
      "usage": "danger 填充上的文字（错误 toast）。"
    },
    "danger-tint": {
      "light": "#B4233F1F",
      "dark": "#FF8FA31F",
      "usage": "错误拖拽遮罩的淡红底（12% 透明）。"
    },
    "warning": {
      "light": "#8A5A00",
      "dark": "#F3C26B",
      "usage": "警告文字，落在 warning-bg 上。"
    },
    "warning-bg": {
      "light": "#FFF4DC",
      "dark": "#3A2C10",
      "usage": "警告条、警告 toast 的底色。"
    },
    "warning-line": {
      "light": "#E8CF97",
      "dark": "#6B4F14",
      "usage": "警告条边框与按钮边界。"
    },
    "warning-solid": {
      "light": "#8A5A00",
      "dark": "#E89A12",
      "usage": "警告 toast 前的感叹号圆点底色。"
    },
    "on-warning-solid": {
      "light": "#FFFFFF",
      "dark": "#1C1B19",
      "usage": "警告圆点里的感叹号。"
    },
    "pop": {
      "light": "#1D5FD6",
      "dark": "#7FB0FF",
      "usage": "拖放落点线、吸附参考线、空容器框；对 surface ≥ 3:1。"
    },
    "hover": {
      "light": "#EEECE8",
      "dark": "#262628",
      "usage": "按钮、标签页、列表项的悬停底色；ink 落在其上。"
    },
    "active": {
      "light": "#F8E1D3",
      "dark": "#43281A",
      "usage": "按下、选中与已开启按钮的底色；ink 落在其上。"
    },
    "toast-bg": {
      "light": "#1C1B19",
      "dark": "#262628",
      "usage": "普通 toast 与尺寸提示的底色。"
    },
    "toast-ink": {
      "light": "#FFFFFF",
      "dark": "#F1F2F6",
      "usage": "toast 主文字。"
    },
    "toast-muted": {
      "light": "#C9C6C0",
      "dark": "#ADABA6",
      "usage": "toast 副文字。"
    }
  },
  "pairs": [
    {
      "fg": "ink",
      "bg": "bg",
      "min": 7.0,
      "role": "正文落在应用背景上"
    },
    {
      "fg": "ink",
      "bg": "surface",
      "min": 7.0,
      "role": "正文落在面板/工具栏上"
    },
    {
      "fg": "ink",
      "bg": "hover",
      "min": 7.0,
      "role": "悬停项文字"
    },
    {
      "fg": "ink",
      "bg": "active",
      "min": 7.0,
      "role": "选中/按下项文字"
    },
    {
      "fg": "ink-muted",
      "bg": "bg",
      "min": 4.5,
      "role": "说明文字在应用背景上"
    },
    {
      "fg": "ink-muted",
      "bg": "surface",
      "min": 4.5,
      "role": "说明文字在面板上"
    },
    {
      "fg": "ink-faint",
      "bg": "surface",
      "min": 4.5,
      "role": "第三级文字在面板上"
    },
    {
      "fg": "ink-faint",
      "bg": "bg",
      "min": 4.5,
      "role": "第三级文字在应用背景上"
    },
    {
      "fg": "ink-faint",
      "bg": "surface-sunken",
      "min": 4.5,
      "role": "代码/凹陷区里的第三级文字"
    },
    {
      "fg": "accent",
      "bg": "bg",
      "min": 4.5,
      "role": "强调文字在应用背景上"
    },
    {
      "fg": "accent",
      "bg": "surface",
      "min": 4.5,
      "role": "强调文字在面板上"
    },
    {
      "fg": "accent",
      "bg": "accent-soft",
      "min": 4.5,
      "role": "选中态里的强调文字"
    },
    {
      "fg": "on-accent",
      "bg": "accent",
      "min": 4.5,
      "role": "主按钮文字"
    },
    {
      "fg": "on-accent",
      "bg": "accent-hover",
      "min": 4.5,
      "role": "主按钮悬停文字"
    },
    {
      "fg": "on-accent",
      "bg": "accent-pressed",
      "min": 4.5,
      "role": "主按钮按下文字"
    },
    {
      "fg": "focus",
      "bg": "bg",
      "min": 3.0,
      "role": "焦点环在应用背景上"
    },
    {
      "fg": "focus",
      "bg": "surface",
      "min": 3.0,
      "role": "焦点环在面板上"
    },
    {
      "fg": "line-strong",
      "bg": "surface",
      "min": 3.0,
      "role": "输入框边界在面板上"
    },
    {
      "fg": "line-strong",
      "bg": "bg",
      "min": 3.0,
      "role": "输入框边界在应用背景上"
    },
    {
      "fg": "success",
      "bg": "surface",
      "min": 4.5,
      "role": "完成状态文字在面板上"
    },
    {
      "fg": "success",
      "bg": "bg",
      "min": 4.5,
      "role": "完成状态文字在应用背景上"
    },
    {
      "fg": "on-success",
      "bg": "success",
      "min": 4.5,
      "role": "改字标签文字"
    },
    {
      "fg": "danger",
      "bg": "surface",
      "min": 4.5,
      "role": "危险操作文字在面板上"
    },
    {
      "fg": "danger",
      "bg": "bg",
      "min": 4.5,
      "role": "错误提示文字在应用背景上"
    },
    {
      "fg": "on-danger",
      "bg": "danger",
      "min": 4.5,
      "role": "错误 toast 文字"
    },
    {
      "fg": "warning",
      "bg": "warning-bg",
      "min": 4.5,
      "role": "警告文字在警告底色上"
    },
    {
      "fg": "on-warning-solid",
      "bg": "warning-solid",
      "min": 4.5,
      "role": "警告圆点里的感叹号"
    },
    {
      "fg": "pop",
      "bg": "surface",
      "min": 3.0,
      "role": "拖放线/参考线在面板上"
    },
    {
      "fg": "pop",
      "bg": "bg",
      "min": 3.0,
      "role": "拖放线/参考线在应用背景上"
    },
    {
      "fg": "toast-ink",
      "bg": "toast-bg",
      "min": 4.5,
      "role": "toast 主文字"
    },
    {
      "fg": "toast-muted",
      "bg": "toast-bg",
      "min": 4.5,
      "role": "toast 副文字"
    }
  ],
  "font": {
    "body": "Inter, -apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Segoe UI\", \"Noto Sans SC\", \"Microsoft YaHei UI\", sans-serif",
    "mono": "\"SF Mono\", ui-monospace, Menlo, Consolas, monospace"
  },
  "type": {
    "micro": {
      "family": "body",
      "size": "10px",
      "line": 1.4,
      "weight": 500
    },
    "micro-plus": {
      "family": "body",
      "size": "10.5px",
      "line": 1.5,
      "weight": 400
    },
    "tiny": {
      "family": "body",
      "size": "11px",
      "line": 1.4,
      "weight": 400
    },
    "tiny-plus": {
      "family": "body",
      "size": "11.5px",
      "line": 1.5,
      "weight": 400
    },
    "small": {
      "family": "body",
      "size": "12px",
      "line": 1.4,
      "weight": 400
    },
    "small-plus": {
      "family": "body",
      "size": "12.5px",
      "line": 1.4,
      "weight": 400
    },
    "body": {
      "family": "body",
      "size": "13px",
      "line": 1.4,
      "weight": 400
    },
    "body-lg": {
      "family": "body",
      "size": "14px",
      "line": 1.6,
      "weight": 400
    },
    "title": {
      "family": "body",
      "size": "18px",
      "line": 1.4,
      "weight": 500
    },
    "heading": {
      "family": "body",
      "size": "20px",
      "line": 1.3,
      "weight": 600
    }
  },
  "space": {
    "0": "0",
    "1": "1px",
    "2": "2px",
    "3": "3px",
    "4": "4px",
    "5": "5px",
    "6": "6px",
    "7": "7px",
    "8": "8px",
    "10": "10px",
    "12": "12px",
    "14": "14px",
    "16": "16px",
    "18": "18px",
    "20": "20px",
    "24": "24px",
    "28": "28px",
    "32": "32px",
    "36": "36px",
    "48": "48px",
    "56": "56px",
    "70": "70px",
    "72": "72px"
  },
  "radius": {
    "xs": "3px",
    "sm": "4px",
    "md": "6px",
    "lg": "8px",
    "xl": "10px",
    "2xl": "12px",
    "3xl": "16px",
    "pill": "999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(15, 16, 22, 0.08)",
    "md": "0 4px 12px rgba(15, 16, 22, 0.10)",
    "lg": "0 10px 30px rgba(15, 16, 22, 0.16)",
    "toast": "0 10px 30px rgba(15, 16, 22, 0.24)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "400ms",
    "ease-out": "ease-out"
  }
}
